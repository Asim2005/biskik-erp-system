# Copy to server/.env and fill in. Never commit the real file.

PORT=5000
NODE_ENV=development

# Local MongoDB. For Atlas use the srv string AND put the database name on
# the end, which Atlas leaves out:
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/biscuit_erp?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/biscuit_erp

# Sign the login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=12h

# Where the browser app is served from, comma separated. On Vercel the client
# and the API share an origin, so this is only needed for local development.
CLIENT_ORIGIN=http://localhost:5173
